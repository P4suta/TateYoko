<Project Sdk="Microsoft.NET.Sdk">
    <!--
    Build tool that regenerates the app icon assets from assets/AppIcon.png: the multi-size
    AppIcon.ico and the MSIX logo PNGs. Uses Magick.NET (Lanczos resampling) for quality.
    It is not a product, but remains in TateYoko.slnx so strict CI compiles the generator.
  -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <RootNamespace>TateYoko.Icons</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Magick.NET-Q16-AnyCPU" Version="14.15.0" />
    </ItemGroup>
</Project>

# Normalize text to LF unless a generating tool requires another checkout form.
* text=auto eol=lf

# NuGet rewrites lock files with CRLF on Windows.
packages*.lock.json text eol=crlf

justfile text eol=lf

*.png binary
*.ico binary
*.pdf binary
*.zip binary
*.snk binary

*.bat text eol=crlf
*.cmd text eol=crlf

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>P4suta/renovate-config"],
  "packageRules": [
    {
      "description": "Keep the runtime for net10.0 tools and tests on .NET 10.",
      "matchFileNames": [".config/runtime/global.json"],
      "matchPackageNames": ["dotnet-sdk"],
      "allowedVersions": "/^10\\./"
    },
    {
      "description": "Keep PDFsharp on the MIT-licensed 6.2 line.",
      "matchDatasources": ["nuget"],
      "matchPackageNames": ["PDFsharp"],
      "allowedVersions": "/^6\\.2\\./"
    }
  ]
}

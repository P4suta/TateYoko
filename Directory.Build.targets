<Project>
    <!-- PDFsharp exposes unused optional modules as runtime assets. -->
    <Target
        Name="RemoveUnusedPdfSharpAssembliesFromBuild"
        AfterTargets="ResolveAssemblyReferences"
        BeforeTargets="_CopyFilesMarkedCopyLocal"
    >
        <ItemGroup>
            <ReferenceCopyLocalPaths
                Remove="@(ReferenceCopyLocalPaths)"
                Condition="
          '%(ReferenceCopyLocalPaths.Filename)' == 'PdfSharp.BarCodes'
          Or '%(ReferenceCopyLocalPaths.Filename)' == 'PdfSharp.Charting'
          Or '%(ReferenceCopyLocalPaths.Filename)' == 'PdfSharp.Cryptography'
          Or '%(ReferenceCopyLocalPaths.Filename)' == 'PdfSharp.Quality'
          Or '%(ReferenceCopyLocalPaths.Filename)' == 'PdfSharp.Snippets'
          Or '%(ReferenceCopyLocalPaths.Filename)' == 'PdfSharp.WPFonts'"
            />
        </ItemGroup>
    </Target>

    <Target
        Name="RemoveUnusedPdfSharpAssembliesFromPublish"
        AfterTargets="_ComputeResolvedCopyLocalPublishAssets"
        BeforeTargets="ComputeFilesToPublish"
    >
        <ItemGroup>
            <_ResolvedCopyLocalPublishAssets
                Remove="@(_ResolvedCopyLocalPublishAssets)"
                Condition="
          '%(_ResolvedCopyLocalPublishAssets.Filename)' == 'PdfSharp.BarCodes'
          Or '%(_ResolvedCopyLocalPublishAssets.Filename)' == 'PdfSharp.Charting'
          Or '%(_ResolvedCopyLocalPublishAssets.Filename)' == 'PdfSharp.Cryptography'
          Or '%(_ResolvedCopyLocalPublishAssets.Filename)' == 'PdfSharp.Quality'
          Or '%(_ResolvedCopyLocalPublishAssets.Filename)' == 'PdfSharp.Snippets'
          Or '%(_ResolvedCopyLocalPublishAssets.Filename)' == 'PdfSharp.WPFonts'"
            />
        </ItemGroup>
    </Target>

    <!-- Publish and MSIX rematerialize item graphs after the build filter. -->
    <Target
        Name="RemoveUnusedPdfSharpAssembliesFromResolvedPublish"
        AfterTargets="ComputeFilesToPublish"
    >
        <ItemGroup>
            <ResolvedFileToPublish
                Remove="@(ResolvedFileToPublish)"
                Condition="
          '%(ResolvedFileToPublish.Filename)' == 'PdfSharp.BarCodes'
          Or '%(ResolvedFileToPublish.Filename)' == 'PdfSharp.Charting'
          Or '%(ResolvedFileToPublish.Filename)' == 'PdfSharp.Cryptography'
          Or '%(ResolvedFileToPublish.Filename)' == 'PdfSharp.Quality'
          Or '%(ResolvedFileToPublish.Filename)' == 'PdfSharp.Snippets'
          Or '%(ResolvedFileToPublish.Filename)' == 'PdfSharp.WPFonts'"
            />
        </ItemGroup>
    </Target>

    <Target
        Name="RemoveUnusedFilesFromMsixPayload"
        AfterTargets="GetPackagingOutputs"
        BeforeTargets="_ComputeAppxPackagePayload"
    >
        <ItemGroup>
            <PackagingOutputs
                Remove="@(PackagingOutputs)"
                Condition="
          '%(PackagingOutputs.Filename)' == 'PdfSharp.BarCodes'
          Or '%(PackagingOutputs.Filename)' == 'PdfSharp.Charting'
          Or '%(PackagingOutputs.Filename)' == 'PdfSharp.Cryptography'
          Or '%(PackagingOutputs.Filename)' == 'PdfSharp.Quality'
          Or '%(PackagingOutputs.Filename)' == 'PdfSharp.Snippets'
          Or '%(PackagingOutputs.Filename)' == 'PdfSharp.WPFonts'
          Or '%(PackagingOutputs.Filename)' == 'Microsoft.DiaSymReader.Native.amd64'
          Or '%(PackagingOutputs.Filename)' == 'Microsoft.DiaSymReader.Native.arm64'
          Or '%(PackagingOutputs.Filename)' == 'mscordaccore'
          Or '%(PackagingOutputs.Filename)' == 'mscordaccore_amd64_amd64_10.0.1026.32716'
          Or '%(PackagingOutputs.Filename)' == 'mscordaccore_arm64_arm64_10.0.1026.32716'
          Or '%(PackagingOutputs.Filename)' == 'mscordbi'"
            />
        </ItemGroup>
    </Target>
</Project>

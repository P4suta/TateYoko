{
  "stryker-config": {
    "test-projects": [
      "../../tests/TateYoko.Engine.Tests/TateYoko.Engine.Tests.csproj"
    ],
    "test-runner": "mtp",
    "configuration": "Release",
    "target-framework": "net10.0",
    "mutation-level": "Complete",
    "coverage-analysis": "all",
    "reporters": [
      "progress",
      "cleartext",
      "html",
      "json"
    ],
    "thresholds": {
      "high": 95,
      "low": 90,
      "break": 90
    },
    "additional-timeout": 3000,
    "break-on-initial-test-failure": true
  }
}

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TateYoko.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TateYoko.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
>
    <Grid
        x:Name="RootDropTarget"
        AllowDrop="True"
        AutomationProperties.AutomationId="DropTarget"
        Background="Transparent"
        DragLeave="OnDragLeave"
        DragOver="OnDragOver"
        Drop="OnDrop"
    >
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OnOpenAcceleratorInvoked" />
        </Grid.KeyboardAccelerators>

        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto"
        >
            <Grid
                MaxWidth="680"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
            >
                <StackPanel
                    x:Name="IdlePanel"
                    x:Load="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                    HorizontalAlignment="Stretch"
                    Spacing="20"
                >
                    <Border
                        Padding="32"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                    >
                        <StackPanel HorizontalAlignment="Center" Spacing="16">
                            <FontIcon
                                AutomationProperties.AccessibilityView="Raw"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE896;"
                            />
                            <TextBlock
                                x:Uid="IdleHeading"
                                HorizontalAlignment="Center"
                                Style="{StaticResource TitleTextBlockStyle}"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                            />
                            <TextBlock
                                x:Uid="IdleDescription"
                                MaxWidth="460"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                            />
                            <Button
                                x:Name="ChoosePdfButton"
                                x:Uid="ChoosePdfButton"
                                AccessKey="O"
                                AutomationProperties.AutomationId="ChoosePdfButton"
                                Click="OnChoosePdfClicked"
                                Style="{StaticResource AccentButtonStyle}"
                            />
                            <TextBlock
                                x:Uid="DropHint"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                            />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel
                    x:Name="ReadyPanel"
                    x:Load="{x:Bind ViewModel.IsReady, Mode=OneWay}"
                    HorizontalAlignment="Stretch"
                    Spacing="20"
                >
                    <TextBlock x:Uid="ReadyHeading" Style="{StaticResource TitleTextBlockStyle}" />

                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                    >
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                AutomationProperties.AccessibilityView="Raw"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xEA90;"
                            />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock
                                    x:Name="InputFileText"
                                    AutomationProperties.AutomationId="InputFileText"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind ViewModel.InputFileName, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.InputFolder, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Uid="OpeningModeLabel"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                        />
                        <RadioButtons
                            x:Name="OpeningModeRadioButtons"
                            AutomationProperties.AutomationId="OpeningModeRadioButtons"
                            SelectedIndex="{x:Bind ViewModel.FirstPageModeIndex, Mode=OneWay}"
                            SelectionChanged="OnOpeningModeChanged"
                        >
                            <RadioButton
                                x:Name="OpeningStandard"
                                AutomationProperties.AutomationId="OpeningStandard"
                            >
                                <StackPanel>
                                    <TextBlock
                                        x:Uid="OpeningStandardTitle"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                    />
                                    <TextBlock
                                        x:Uid="OpeningStandardDescription"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                    />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton
                                x:Name="OpeningCover"
                                AutomationProperties.AutomationId="OpeningCover"
                            >
                                <StackPanel>
                                    <TextBlock
                                        x:Uid="OpeningCoverTitle"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                    />
                                    <TextBlock
                                        x:Uid="OpeningCoverDescription"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                    />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton
                                x:Name="OpeningLeadingBlank"
                                AutomationProperties.AutomationId="OpeningLeadingBlank"
                            >
                                <StackPanel>
                                    <TextBlock
                                        x:Uid="OpeningLeadingBlankTitle"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                    />
                                    <TextBlock
                                        x:Uid="OpeningLeadingBlankDescription"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                    />
                                </StackPanel>
                            </RadioButton>
                        </RadioButtons>
                    </StackPanel>

                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                    >
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock
                                    x:Uid="OutputLabel"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                />
                                <TextBlock
                                    x:Name="OutputFileText"
                                    AutomationProperties.AutomationId="OutputFileText"
                                    Text="{x:Bind ViewModel.OutputFileName, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.OutputFolder, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                />
                                <TextBlock
                                    x:Uid="CollisionNote"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap"
                                />
                            </StackPanel>
                            <Button
                                x:Name="ChangeOutputButton"
                                x:Uid="ChangeOutputButton"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="ChangeOutputButton"
                                Click="OnChangeOutputClicked"
                            />
                        </Grid>
                    </Border>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="ConvertButton"
                            x:Uid="ConvertButton"
                            AutomationProperties.AutomationId="ConvertButton"
                            Command="{x:Bind ViewModel.ConvertCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                        />
                        <Button
                            x:Name="PickAnotherButton"
                            x:Uid="PickAnotherButton"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="PickAnotherButton"
                            Click="OnChoosePdfClicked"
                        />
                    </Grid>
                </StackPanel>

                <StackPanel
                    x:Name="ConvertingPanel"
                    x:Load="{x:Bind ViewModel.IsConverting, Mode=OneWay}"
                    HorizontalAlignment="Stretch"
                    Spacing="20"
                >
                    <TextBlock
                        x:Uid="ConvertingHeading"
                        Style="{StaticResource TitleTextBlockStyle}"
                    />
                    <ProgressBar
                        x:Name="ConversionProgress"
                        AutomationProperties.AutomationId="ConversionProgress"
                        AutomationProperties.Name="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                        IsIndeterminate="False"
                        Maximum="100"
                        Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}"
                    />
                    <TextBlock
                        x:Name="ProgressText"
                        AutomationProperties.AutomationId="ProgressText"
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                    />
                    <Button
                        x:Name="CancelButton"
                        x:Uid="CancelButton"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="CancelButton"
                        Command="{x:Bind ViewModel.CancelCommand}"
                    />
                </StackPanel>

                <StackPanel
                    x:Name="PasswordPanel"
                    x:Load="{x:Bind ViewModel.IsPasswordRequired, Mode=OneWay}"
                    HorizontalAlignment="Stretch"
                    Spacing="16"
                >
                    <InfoBar
                        x:Uid="PasswordInfo"
                        IsClosable="False"
                        IsIconVisible="True"
                        IsOpen="True"
                        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Severity="Warning"
                    />
                    <PasswordBox
                        x:Name="PasswordInput"
                        x:Uid="PasswordInput"
                        AutomationProperties.AutomationId="PasswordInput"
                        PasswordRevealMode="Peek"
                    />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="RetryPasswordButton"
                            x:Uid="RetryPasswordButton"
                            AutomationProperties.AutomationId="RetryPasswordButton"
                            Click="OnRetryPasswordClicked"
                            Style="{StaticResource AccentButtonStyle}"
                        />
                        <Button
                            x:Name="PasswordChooseAnotherButton"
                            x:Uid="PickAnotherButton"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="PasswordChooseAnotherButton"
                            Click="OnChoosePdfClicked"
                        />
                    </Grid>
                </StackPanel>

                <StackPanel
                    x:Name="DonePanel"
                    x:Load="{x:Bind ViewModel.IsDone, Mode=OneWay}"
                    HorizontalAlignment="Stretch"
                    Spacing="16"
                >
                    <InfoBar
                        x:Uid="DoneInfo"
                        IsClosable="False"
                        IsIconVisible="True"
                        IsOpen="True"
                        Severity="Success"
                    />
                    <InfoBar
                        x:Name="OutputActionErrorInfoBar"
                        x:Uid="OutputActionErrorInfo"
                        x:Load="{x:Bind ViewModel.HasActionError, Mode=OneWay}"
                        IsClosable="False"
                        IsIconVisible="True"
                        IsOpen="True"
                        Message="{x:Bind ViewModel.ActionErrorMessage, Mode=OneWay}"
                        Severity="Error"
                    />
                    <TextBlock
                        x:Name="DoneOutputFileText"
                        AutomationProperties.AutomationId="DoneOutputFileText"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.OutputFileName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                    />
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="OpenOutputButton"
                            x:Uid="OpenOutputButton"
                            AutomationProperties.AutomationId="OpenOutputButton"
                            Command="{x:Bind ViewModel.OpenOutputCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                        />
                        <Button
                            x:Name="ShowFolderButton"
                            x:Uid="ShowFolderButton"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="ShowFolderButton"
                            Command="{x:Bind ViewModel.ShowInFolderCommand}"
                        />
                    </Grid>
                    <Button
                        x:Name="AnotherPdfButton"
                        x:Uid="AnotherPdfButton"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="AnotherPdfButton"
                        Click="OnChoosePdfClicked"
                    />
                </StackPanel>

                <StackPanel
                    x:Name="ErrorPanel"
                    x:Load="{x:Bind ViewModel.IsError, Mode=OneWay}"
                    HorizontalAlignment="Stretch"
                    Spacing="16"
                >
                    <InfoBar
                        x:Name="ErrorInfo"
                        x:Uid="ErrorInfo"
                        AutomationProperties.AutomationId="ErrorInfo"
                        IsClosable="False"
                        IsIconVisible="True"
                        IsOpen="True"
                        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Severity="Error"
                    />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            x:Name="RetryButton"
                            x:Uid="RetryButton"
                            x:Load="{x:Bind ViewModel.CanRetryCurrentError, Mode=OneWay}"
                            AutomationProperties.AutomationId="RetryButton"
                            Command="{x:Bind ViewModel.RetryCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                        />
                        <Button
                            x:Name="ErrorChooseAnotherButton"
                            x:Uid="PickAnotherButton"
                            AutomationProperties.AutomationId="ErrorChooseAnotherButton"
                            Click="OnChoosePdfClicked"
                        />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border
            x:Name="DragOverlay"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
            BorderThickness="3"
            IsHitTestVisible="False"
            Visibility="Collapsed"
        >
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <FontIcon
                    AutomationProperties.AccessibilityView="Raw"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="&#xE896;"
                />
                <TextBlock x:Uid="DropOverlayText" Style="{StaticResource TitleTextBlockStyle}" />
            </StackPanel>
        </Border>

        <TextBlock
            x:Name="LiveRegionText"
            Width="1"
            Height="1"
            AutomationProperties.AutomationId="LiveRegionText"
            AutomationProperties.LiveSetting="Polite"
            IsHitTestVisible="False"
            Opacity="0"
            Text="{x:Bind ViewModel.StatusAnnouncement, Mode=OneWay}"
        />
    </Grid>
</Page>

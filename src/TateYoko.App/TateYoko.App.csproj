<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
        <RootNamespace>TateYoko.App</RootNamespace>
        <AssemblyName>TateYoko</AssemblyName>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
        <Platforms>x64;ARM64</Platforms>
        <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''"
            >win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
        <UseWinUI>true</UseWinUI>
        <WinUISDKReferences>false</WinUISDKReferences>
        <EnableMsixTooling>true</EnableMsixTooling>
        <EnableWinAppRunSupport>true</EnableWinAppRunSupport>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <!-- Required only by LibraryImport-generated P/Invoke; the application has no handwritten unsafe code. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefaultLanguage>en-US</DefaultLanguage>
        <!-- Ship only the languages declared in Package.appxmanifest and covered by contract tests. -->
        <SatelliteResourceLanguages>en-US;ja-JP;zh-CN</SatelliteResourceLanguages>
        <DistributionMode Condition="'$(DistributionMode)' == ''">Msix</DistributionMode>
        <!-- MSIX carries .NET while Windows services the Windows App SDK framework package. -->
        <SelfContained Condition="'$(DistributionMode)' != 'Reference'">true</SelfContained>
        <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>

        <!-- WinUI + trimming can break XAML reflection, so disable trimming. -->
        <PublishTrimmed>false</PublishTrimmed>
        <NuGetLockFilePath
            Condition="'$(PublishReadyToRun)' == 'true' and '$(DistributionMode)' != 'Reference'"
            >packages.msix.lock.json</NuGetLockFilePath>
    </PropertyGroup>

    <PropertyGroup Condition="'$(DistributionMode)' == 'Reference'">
        <!-- Unit-test ProjectReference builds compile app logic without becoming a second distribution. -->
        <SelfContained>false</SelfContained>
        <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
        <EnableWinAppRunSupport>false</EnableWinAppRunSupport>
    </PropertyGroup>

    <ItemGroup>
        <!-- Required at runtime by AppWindow.SetIcon and the custom WinUI title bar. -->
        <Content
            Include="Assets\AppIcon.ico"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest"
        />
        <Content
            Include="Assets\SplashScreen.scale-200.png"
            CopyToOutputDirectory="PreserveNewest"
        />
        <Content
            Include="Assets\Square150x150Logo.scale-200.png"
            CopyToOutputDirectory="PreserveNewest"
        />
        <Content
            Include="Assets\Square44x44Logo.scale-200.png"
            CopyToOutputDirectory="PreserveNewest"
        />
        <Content
            Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png"
            CopyToOutputDirectory="PreserveNewest"
        />
        <Content
            Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png"
            CopyToOutputDirectory="PreserveNewest"
        />
        <Content Include="Assets\StoreLogo.png" CopyToOutputDirectory="PreserveNewest" />
        <Content
            Include="Assets\Wide310x150Logo.scale-200.png"
            CopyToOutputDirectory="PreserveNewest"
        />
        <Content
            Include="..\..\LICENSE"
            Link="LICENSE.txt"
            CopyToOutputDirectory="PreserveNewest"
        />
        <Content
            Include="..\..\build\legal\THIRD-PARTY-NOTICES.txt"
            Link="THIRD-PARTY-NOTICES.txt"
            Condition="Exists('..\..\build\legal\THIRD-PARTY-NOTICES.txt')"
            CopyToOutputDirectory="PreserveNewest"
        />
    </ItemGroup>

    <ItemGroup>
        <Manifest Include="$(ApplicationManifest)" />
    </ItemGroup>

    <ItemGroup Condition="'$(ReleaseAppxManifest)' != ''">
        <!-- Release tooling supplies an isolated manifest copy with the requested package version.
             Explicit inclusion prevents the MSIX SDK from falling back to the design-time manifest. -->
        <AppxManifest Include="$(ReleaseAppxManifest)">
            <SubType>Designer</SubType>
        </AppxManifest>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.5" />
        <PackageReference
            Include="Microsoft.WindowsAppSDK.InteractiveExperiences"
            Version="2.1.3"
        />
        <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.3.1" />
        <!-- Keep the component set aligned with Runtime 2.3.1's validated matrix. -->
        <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.0" />
        <PackageReference
            Include="Microsoft.Windows.SDK.BuildTools"
            Version="10.0.28000.2526"
            PrivateAssets="all"
        />
        <PackageReference
            Include="Microsoft.Windows.SDK.BuildTools.WinApp"
            Version="0.5.0"
            PrivateAssets="all"
        />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\TateYoko.Engine\TateYoko.Engine.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="TateYoko.App.Tests" />
    </ItemGroup>

    <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)' != 'true' and '$(EnableMsixTooling)' == 'true'">
        <ProjectCapability Include="Msix" />
    </ItemGroup>

    <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)' != 'true' and '$(EnableMsixTooling)' == 'true'">
        <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
    </PropertyGroup>

    <Target
        Name="RemoveUnsupportedWinUiMuiResources"
        AfterTargets="_UpdateMuiFilesAfterNugetRestore"
    >
        <ItemGroup>
            <!-- WinUI publishes native MUI files for every available language. Keep the payload aligned
           with TateYoko's explicit three-language product contract. -->
            <RuntimeTargetsCopyLocalItems
                Remove="@(RuntimeTargetsCopyLocalItems)"
                Condition="
          '%(RuntimeTargetsCopyLocalItems.Extension)' == '.mui'
          And '%(RuntimeTargetsCopyLocalItems.DestinationSubDirectory)' != 'en-us\'
          And '%(RuntimeTargetsCopyLocalItems.DestinationSubDirectory)' != 'ja-JP\'
          And '%(RuntimeTargetsCopyLocalItems.DestinationSubDirectory)' != 'zh-CN\'"
            />
        </ItemGroup>
    </Target>

    <Target
        Name="RemoveUnsupportedWindowsAppSdkMuiResources"
        AfterTargets="AddMicrosoftWindowsAppSDKPayloadFilesFromComponents"
    >
        <ItemGroup>
            <None
                Remove="@(None)"
                Condition="
          '%(None.Extension)' == '.mui'
          And '%(None.RecursiveDir)' != 'en-us\'
          And '%(None.RecursiveDir)' != 'ja-JP\'
          And '%(None.RecursiveDir)' != 'zh-CN\'"
            />
        </ItemGroup>
    </Target>

    <Target
        Name="RequireLegalPayloadForMsix"
        BeforeTargets="GenerateAppxPackageRecipe"
        Condition="'$(DistributionMode)' != 'Reference'"
    >
        <Error
            Condition="!Exists('..\..\build\legal\THIRD-PARTY-NOTICES.txt')"
            Text="Generate build/legal/THIRD-PARTY-NOTICES.txt before packaging."
        />
    </Target>
</Project>

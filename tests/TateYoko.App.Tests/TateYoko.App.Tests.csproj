<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
        <Platforms>x64;ARM64</Platforms>
        <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''"
            >win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <!-- Unit tests exercise only app logic. Never activate or deploy the WinAppSDK runtime. -->
        <WindowsAppSdkAutoInitialize>false</WindowsAppSdkAutoInitialize>
        <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
        <ExpandPriResources>false</ExpandPriResources>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.MTP" Version="10.0.1" />
        <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference
            Include="..\..\src\TateYoko.App\TateYoko.App.csproj"
            AdditionalProperties="DistributionMode=Reference;WindowsAppSdkAutoInitialize=false;IntermediateOutputPath=obj\Reference\$(Configuration)\;OutputPath=bin\Reference\$(Configuration)\"
        />
    </ItemGroup>

    <ItemGroup>
        <None Update="testconfig.json" CopyToOutputDirectory="PreserveNewest" />
        <!-- Contract tests consume explicit immutable inputs instead of assuming that the test
         assembly lives somewhere under a repository checkout. -->
        <None
            Include="..\..\src\TateYoko.App\MainPage.xaml"
            Link="TestInputs\AppSource\MainPage.xaml"
            CopyToOutputDirectory="PreserveNewest"
        />
        <None
            Include="..\..\src\TateYoko.App\Strings\**\Resources.resw"
            Link="TestInputs\AppSource\Strings\%(RecursiveDir)Resources.resw"
            CopyToOutputDirectory="PreserveNewest"
        />
        <None
            Include="..\..\src\TateYoko.App\**\*.cs"
            Exclude="..\..\src\TateYoko.App\bin\**;..\..\src\TateYoko.App\obj\**"
            Link="TestInputs\AppSource\%(RecursiveDir)%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
        />
    </ItemGroup>
</Project>
